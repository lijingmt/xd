# Git 相关
.git
.gitignore
.gitattributes
.env
.env.*
!.env.example
.claude/

# 日志文件
log/
*.log

# 数据文件
data_xiand/
*.s
*.o

# 逻辑区是运行时热配置，只通过宿主持久化目录挂载。
# 镜像只保留 README.md 和 zone.conf.example，避免把某台机器的
# xdNN.conf 随镜像发布到其他服务器。
gamelib/etc/logical_zones/xd*.conf

# 游戏物品数据（通过卷映射，不打包到镜像）
gamelib/clone/item/

# 临时文件
tmp/
.include/
*.tmp
*.bak
*.swp
*~

# IDE 配置
.idea/
.vscode/
*.iml

# Node modules (vue_source 会在构建时处理)
vue_source/node_modules/

# 编译产物
dist/

# Docker 运行时静态契约需要随镜像进入 TestUnit；只保留构建与编排文件，
# 其余 Docker 辅助内容继续排除。
docker/*
!docker/Dockerfile.all
!docker/docker-compose.yml
!docker/start-unified.sh

# 脚本输出
*.pid
*.state

# 数据库备份
db_bak/
db_log/

# 核心 dump 文件
core.*

# macOS
.DS_Store

# Linux
*~
