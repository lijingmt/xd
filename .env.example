# Xiand Docker 环境变量模板
#
# 首次部署或旧 .env 升级只需直接执行：
#   ./restart-docker.sh xd01 9001 8888 --workers 3
# 脚本每次会先读取旧 .env 的 MYSQL_PASSWORD，再用本模板重建权限为
# 600 的 .env 并写回密码；其他令牌会重新安全生成。没有旧密码时会
# 静默询问 MYSQL_PASSWORD。也可先手动执行：
#   ./scripts/setup_deploy_env.sh
#
# .env 含生产凭证，已被 .gitignore 和 .dockerignore 排除，禁止提交；
# 本模板和初始化脚本会提交到 Git。

# MySQL（MYSQL_PASSWORD 必填，必须填写数据库当前真实密码）
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# 当前容器管理的区服。单区示例：xd01；合区示例：xd01-02。
GAME_AREA=xd01

# Vue 登录页显示的区服列表，逗号分隔。
GAME_AREAS=xd01,xd02,xd03,xd04,xd05

# 详细 /health 指标访问令牌，可用 `openssl rand -hex 32` 生成。
# 至少 24 位；留空时公开接口只返回 status 和 time。
XIAND_HEALTH_TOKEN=

# 地图 worker 内部令牌。仅试运行多 worker 时需要；至少32位，建议：
#   openssl rand -hex 32
# 不得提交真实令牌，也不得复用 MYSQL_PASSWORD。
XIAND_WORKER_TOKEN=

# 傻瓜部署默认启动3个 shadow worker；玩家仍由旧主进程服务，适合试运行。
# restart-docker.sh 会在宿主机持久化目录中首次创建 config.json，之后管理后台
# 修改的配置不会被容器重建覆盖。XIAND_WORKER_TOKEN 留空时部署脚本自动安全生成。
XIAND_MAP_WORKER_ENABLED=1
XIAND_MAP_WORKER_TRAFFIC_MODE=shadow
XIAND_MAP_WORKER_COUNT=3
XIAND_MAP_WORKER_CAPACITY=100
# active 发生故障时会持久化 fallback-latched 并回到旧主进程；人工确认恢复前
# 不会自动切回 worker。
# active 仅供隔离测试机，不能在生产 .env 中预设确认值：
# XIAND_MAP_WORKER_ACTIVE_TRIAL_ACK=isolated-test-server-only
# 过期人物租约/首登临时地图每小时在停流盘点后安全回收，通常无需修改：
# XIAND_MAP_WORKER_LEASE_GC_SECONDS=3600

# 可选端口；通常保持默认值即可。
MUD_PORT=13800
HTTP_API_PORT=8888
TOMCAT_HTTP_PORT=9001
TOMCAT_HTTPS_PORT=8443
