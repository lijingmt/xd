# Xiand Docker 环境变量模板
#
# 首次部署只需：
#   cp .env.example .env
#   chmod 600 .env
#   vi .env                    # 填写 MYSQL_PASSWORD
#
# .env 含生产凭证，已被 .gitignore 和 .dockerignore 排除，禁止提交。

# MySQL（MYSQL_PASSWORD 必填，必须填写数据库当前真实密码）
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

# 当前容器管理的区服。单区示例：xd01；合区示例：xd01-02。
GAME_AREA=xd01

# Vue 登录页显示的区服列表，逗号分隔。
GAME_AREAS=xd01,xd02,xd03,xd04,xd05

# 详细 /health 指标访问令牌，可用 `openssl rand -hex 32` 生成。
# 至少 24 位；留空时公开接口只返回 status 和 time。
XIAND_HEALTH_TOKEN=

# 可选端口；通常保持默认值即可。
MUD_PORT=13800
HTTP_API_PORT=8888
TOMCAT_HTTP_PORT=9001
TOMCAT_HTTPS_PORT=8443
