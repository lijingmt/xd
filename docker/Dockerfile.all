# ============================================
# xiand 统一镜像 - Pike MUD + Tomcat Web
# ============================================
# 在一个容器内同时运行 Pike MUD 和 Tomcat
# JSP 可以通过 127.0.0.1:13800 直接连接到 MUD
# 基于 CentOS Stream 10

# ============================================
# Stage 1: 编译 Pike 9.0 + MySQL 支持
# ============================================
FROM quay.io/centos/centos:stream10 AS pike-builder

ARG PIKE_VERSION=9.0.13

# 设置工作目录
WORKDIR /tmp/build

# 安装编译依赖
# 启用 PowerTools/CRB 仓库以获取更多开发包
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf install -y \
    gcc gcc-c++ make autoconf bison flex \
    gmp-devel nettle-devel \
    mariadb-devel mariadb-connector-c-devel \
    libpng-devel libjpeg-devel \
    sqlite-devel \
    zlib-devel \
    git && \
    dnf clean all

# 下载 Pike 官方源码包（从官网下载的预打包版本）
RUN cd /tmp/build && \
    curl -fSL --retry 5 --retry-delay 5 --retry-all-errors \
      -o "Pike-v${PIKE_VERSION}.tar.gz" \
      "https://pike.lysator.liu.se/pub/pike/beta/${PIKE_VERSION}/Pike-v${PIKE_VERSION}.tar.gz" && \
    gzip -t "Pike-v${PIKE_VERSION}.tar.gz" && \
    tar xzf "Pike-v${PIKE_VERSION}.tar.gz" && \
    mv "Pike-v${PIKE_VERSION}" pike9

# 编译 Pike
WORKDIR /tmp/build/pike9

# 从源码编译完整版 nettle 获得 nettle_sm3 支持
RUN cd /tmp/build && \
    curl -sL https://ftp.gnu.org/gnu/nettle/nettle-3.10.1.tar.gz | tar xz && \
    cd nettle-3.10.1 && \
    ./configure --prefix=/usr --libdir=/usr/lib64 --enable-shared && \
    make -j4 && \
    make install && \
    ldconfig

# Pike 编译
RUN export CFLAGS="-O2" && \
    export CXXFLAGS="-O2" && \
    rm -rf src/post_modules/GI src/post_modules/FFI && \
    mkdir -p /tmp/build/pike9/build && \
    cd /tmp/build/pike9/build && \
    /tmp/build/pike9/src/configure --prefix=/usr/local/pike9 \
      --with-mysql \
      --with-gmp \
      --with-nettle \
      --with-sqlite \
      --without-java \
      --without-gtk2 \
      --without-gl \
      --without-glut \
      --disable-rpath && \
    make -j4 2>&1 && \
    make install 2>&1

# 验证 MySQL 模块
RUN /usr/local/pike9/bin/pike -e 'int main() { \
    object sql = master()->resolv("Sql")["Sql"]; \
    if(sql && sql->_mysql) { \
        write("✓ MySQL module compiled successfully\n"); \
        return 0; \
    } else { \
        write("✗ MySQL module not found\n"); \
        return 1; \
    } \
}'

# 验证 SSL/Crypto 模块
RUN /usr/local/pike9/bin/pike -e 'int main() { \
    object ssl = master()->resolv("SSL"); \
    object crypto = master()->resolv("Crypto"); \
    if(ssl && crypto) { \
        write("✓ SSL/Crypto module available\n"); \
        return 0; \
    } else { \
        write("✗ SSL/Crypto module not found\n"); \
        return 1; \
    } \
}'

# ============================================
# Stage 2: 统一运行时镜像
# ============================================
FROM quay.io/centos/centos:stream10

# 安装运行时依赖（包括编译好的 nettle 库）
COPY --from=pike-builder /usr/lib64/libnettle.so.8* /usr/lib64/
COPY --from=pike-builder /usr/lib64/libhogweed.so.6* /usr/lib64/

RUN dnf install -y \
    java-21-openjdk \
    java-21-openjdk-devel \
    mariadb-connector-c \
    mariadb-connector-odbc \
    mariadb \
    gmp \
    gdbm-libs \
    sqlite-libs \
    zlib \
    curl \
    socat \
    tzdata && \
    ldconfig && \
    dnf clean all

# 从编译阶段复制 Pike
COPY --from=pike-builder /usr/local/pike9 /usr/local/pike9

# 安装 Tomcat 11
ENV TOMCAT_VERSION="11.0.2"
RUN cd /tmp && \
    curl -sL https://archive.apache.org/dist/tomcat/tomcat-11/v${TOMCAT_VERSION}/bin/apache-tomcat-${TOMCAT_VERSION}.tar.gz | tar xz && \
    mv apache-tomcat-${TOMCAT_VERSION} /usr/local/tomcat && \
    rm -rf /tmp/apache-tomcat-* && \
    chmod +x /usr/local/tomcat/bin/*.sh

# 设置 PATH 包含 Pike 和时区
ENV PATH="/usr/local/pike9/bin:${PATH}" \
    PIKE_INCLUDE_PATH="/usr/local/pike9/include/pike" \
    PIKE_MODULE_PATH="/usr/local/pike9/lib/pike/modules" \
    CATALINA_HOME="/usr/local/tomcat" \
    TZ="Asia/Shanghai"

# 设置系统时区
RUN echo "Asia/Shanghai" > /etc/timezone && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

# 创建 MUD 运行用户
RUN useradd -m -u 2000 -s /bin/bash muduser 2>/dev/null || true

# 创建必要的目录
RUN mkdir -p /app/xiand /var/lib/mysql && \
    chmod 755 /app && \
    chmod 755 /app/xiand && \
    chmod 777 /var/lib/mysql && \
    chown -R muduser:muduser /app /var/lib/mysql 2>/dev/null || true

# 创建数据目录挂载点（用于卷映射）
RUN mkdir -p /app/xiand/data_xiand /app/xiand/gamelib/clone/item && \
    chmod 700 /app/xiand/data_xiand && \
    chmod 755 /app/xiand/gamelib/clone/item

# 复制整个 xiand 项目到容器
COPY . /app/xiand/

# etc 在运行时会被宿主目录遮蔽，因此保留一份只读首装快照。
# .dockerignore 已排除活动 xdNN.conf；逻辑区首装配置来自 deploy/logical_zones。
RUN mkdir -p /app/xiand-bootstrap/etc && \
    cp -a /app/xiand/gamelib/etc/. /app/xiand-bootstrap/etc/

# 复制前端文件到 Tomcat ROOT
COPY web /usr/local/tomcat/webapps/ROOT

# 复制游戏图片到 Tomcat ROOT/xd/images/ (游戏代码使用 /xd/images/ 路径)
RUN mkdir -p /usr/local/tomcat/webapps/ROOT/xd/images && \
    cp /app/xiand/images/* /usr/local/tomcat/webapps/ROOT/xd/images/ && \
    echo "Copied $(ls /usr/local/tomcat/webapps/ROOT/xd/images/ | wc -l) images to ROOT/xd/images/"

# 设置权限
RUN chmod -R 755 /usr/local/tomcat/webapps/ROOT && \
    chmod +x /app/xiand/docker/docker-startup.sh 2>/dev/null || true && \
    chmod 755 /app/xiand

# 工作目录
WORKDIR /app/xiand

# 暴露端口
EXPOSE 13800 8080 8443

# 创建统一的启动脚本
RUN cat > /app/start-unified.sh << 'EOF'
#!/bin/bash
set -e

export PATH="/usr/local/pike9/bin:${PATH}"

# 解析游戏区号
GAME_AREA_INPUT="${GAME_AREA:-xd01}"
if [[ $GAME_AREA_INPUT =~ ^xd ]]; then
    GAME_PREFIX="$GAME_AREA_INPUT"
    GAME_AREA="${GAME_AREA_INPUT#xd}"
else
    GAME_PREFIX="xd${GAME_AREA_INPUT}"
    GAME_AREA="$GAME_AREA_INPUT"
fi

export GAME_PREFIX GAME_AREA

# 兼容首次在全新生产机上使用 docker compose：空的 etc 挂载会先从镜像快照
# 初始化，再补入逻辑区种子。已有任何文件均不覆盖，后续重建保持线上配置。
ETC_RUNTIME_DIR="/app/xiand/gamelib/etc"
ETC_BOOTSTRAP_DIR="/app/xiand-bootstrap/etc"
LOGICAL_ZONE_RUNTIME_DIR="${ETC_RUNTIME_DIR}/logical_zones"
LOGICAL_ZONE_IMAGE_SEED_DIR="/app/xiand/deploy/logical_zones"
mkdir -p "${ETC_RUNTIME_DIR}" "${LOGICAL_ZONE_RUNTIME_DIR}"
if [ ! -e "${ETC_RUNTIME_DIR}/regname" ]; then
    cp -an "${ETC_BOOTSTRAP_DIR}/." "${ETC_RUNTIME_DIR}/"
fi
ZONE_CONFIG_FOUND=0
for ZONE_CONFIG in "${LOGICAL_ZONE_RUNTIME_DIR}"/xd[0-9][0-9].conf; do
    [ -f "${ZONE_CONFIG}" ] || continue
    ZONE_CONFIG_FOUND=1
    break
done
if [ "${ZONE_CONFIG_FOUND}" -eq 0 ]; then
    for ZONE_SEED in "${LOGICAL_ZONE_IMAGE_SEED_DIR}"/xd[0-9][0-9].conf; do
        [ -f "${ZONE_SEED}" ] || continue
        cp -pn "${ZONE_SEED}" "${LOGICAL_ZONE_RUNTIME_DIR}/"
    done
fi
chmod 755 "${ETC_RUNTIME_DIR}" "${LOGICAL_ZONE_RUNTIME_DIR}" 2>/dev/null || true
chmod 644 "${LOGICAL_ZONE_RUNTIME_DIR}"/*.conf 2>/dev/null || true

# 读取 MySQL 配置
MYSQL_HOST="${MYSQL_HOST:-172.17.0.1}"
MYSQL_PORT="${MYSQL_PORT:-3306}"
MYSQL_USER="${MYSQL_USER:-root}"
MYSQL_PASSWORD="${MYSQL_PASSWORD:-}"
if [ -z "${MYSQL_PASSWORD}" ]; then
    echo "MYSQL_PASSWORD is required" >&2
    exit 1
fi

# 创建必要目录。db_log 在 .dockerignore 中，不会随镜像复制；注册和每日
# 统计写入前必须显式创建，避免注册初始化被日志异常中断。
umask 027
mkdir -p /app/xiand/log /app/xiand/log/stat/reg \
    /app/xiand/log/stat/daily /app/xiand/db_log/reg_new \
    /app/xiand/db_log/daily_user /var/lib/mysql /tmp
chmod 750 /app/xiand/log /app/xiand/log/stat \
    /app/xiand/log/stat/reg /app/xiand/log/stat/daily
chmod 700 /app/xiand/db_log /app/xiand/db_log/reg_new \
    /app/xiand/db_log/daily_user
find /app/xiand/data_xiand -type d -exec chmod 700 {} + 2>/dev/null || true
find /app/xiand/data_xiand -type f -exec chmod 600 {} + 2>/dev/null || true
# 创建基础设施日志文件
touch /tmp/socat.log /tmp/socat_3306.log

# 启动 socat 来将 Unix socket 转发到 TCP MySQL
rm -f /tmp/.mysql_sock /var/lib/mysql/mysql.sock /run/mysqld/mysqld.sock 2>/dev/null || true
mkdir -p /run/mysqld
socat UNIX-LISTEN:/tmp/.mysql_sock,fork,reuseaddr,mode=666 TCP:${MYSQL_HOST}:${MYSQL_PORT} > /tmp/socat.log 2>&1 &
# 启动 socat 将容器内 127.0.0.1:3306 转发到宿主机 MySQL
socat TCP-LISTEN:3306,fork,reuseaddr,bind=127.0.0.1 TCP:${MYSQL_HOST}:${MYSQL_PORT} > /tmp/socat_3306.log 2>&1 &
sleep 1
# 创建多个 socket 符号链接以兼容不同的连接路径
ln -sf /tmp/.mysql_sock /var/lib/mysql/mysql.sock 2>/dev/null || true
ln -sf /tmp/.mysql_sock /run/mysqld/mysqld.sock 2>/dev/null || true

# 初始化数据库
DB_NAME="${GAME_PREFIX}"
if ! MYSQL_PWD="${MYSQL_PASSWORD}" mariadb \
    -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${MYSQL_USER}" \
    -e "SELECT 1" >/dev/null 2>&1; then
    echo "MySQL authentication failed; refusing to start Xiand" >&2
    exit 1
fi
if ! MYSQL_PWD="${MYSQL_PASSWORD}" mariadb \
    -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${MYSQL_USER}" \
    -e "CREATE DATABASE IF NOT EXISTS \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;" \
    >/dev/null 2>&1; then
    echo "MySQL database initialization failed; refusing to start Xiand" >&2
    exit 1
fi

# 检查数据库是否为空，如果为空则导入 xd.sql
if ! TABLE_COUNT=$(MYSQL_PWD="${MYSQL_PASSWORD}" mariadb \
    -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${MYSQL_USER}" -N -B \
    -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='${DB_NAME}';" \
    2>/dev/null); then
    echo "MySQL schema check failed; refusing to start Xiand" >&2
    exit 1
fi
if [ "$TABLE_COUNT" -eq 0 ]; then
    echo "数据库 ${DB_NAME} 为空，正在导入 xd.sql..."
    if [ -f /app/xiand/xd.sql ]; then
        if MYSQL_PWD="${MYSQL_PASSWORD}" mariadb \
            -h "${MYSQL_HOST}" -P "${MYSQL_PORT}" -u "${MYSQL_USER}" \
            "${DB_NAME}" < /app/xiand/xd.sql 2>/dev/null; then
            echo "✓ 数据库导入成功"
        else
            echo "✗ 数据库导入失败，拒绝启动 Xiand" >&2
            exit 1
        fi
    else
        echo "xd.sql 文件不存在，拒绝启动 Xiand" >&2
        exit 1
    fi
else
    echo "数据库 ${DB_NAME} 已有 ${TABLE_COUNT} 张表，跳过导入"
fi

# 启动Pike MUD
echo "启动Pike MUD (区号: ${GAME_PREFIX})..."
cd /app/xiand
# 设置系统栈和 Pike 内部栈，防止启动期编译大量对象时栈溢出
ulimit -s unlimited
pike -s1000000 -ss67108864 /app/xiand/lowlib/driver.pike -i 0.0.0.0 -p 13800 /app/xiand/ > /app/xiand/log/pike.log 2>&1 &
PIKE_PID=$!
echo "✓ Pike MUD 已启动 (PID: $PIKE_PID)"

sleep 10


# 启动Tomcat
exec /usr/local/tomcat/bin/catalina.sh run
EOF

RUN chmod +x /app/start-unified.sh

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -fsS --max-time 5 http://127.0.0.1:8888/health >/dev/null || exit 1

# 启动脚本
CMD ["/app/start-unified.sh"]
