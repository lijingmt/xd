inherit WAP_BOOK;
protected void create(){
	name=object_name(this_object());
	name_cn="【方】龟灵一级";
	unit="本";
	picture=name;
	desc="召唤灵龟附体，在持续时间内提升生命上限\n";
	set_item_canDrop(1);
	set_item_canGet(1);
	set_item_canTrade(1);
	set_item_canSend(1);
	set_item_canStorage(1);
	value=50;
	skill_bname="guiling";
	level_limit=20;
	profe_read_limit="方士";
	need_yushi=10;
	need_money=150;
}
int read(){
	int result=::read();
	if(read_flag==0){
		remove();
	}
	return result;
}
