inherit WAP_BOOK;
protected void create(){
	name=object_name(this_object());
	name_cn="【方】唤小灵";
	unit="本";
	picture=name;
	desc="召唤一只小灵兽协助战斗，持续60秒\n";
	set_item_canDrop(1);
	set_item_canGet(1);
	set_item_canTrade(1);
	set_item_canSend(1);
	set_item_canStorage(1);
	value=160;
	skill_bname="huanxiaoling";
	level_limit=18;
	profe_read_limit="方士";
	need_yushi=15;
	need_money=160;
