#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ARMOR;

protected void create()
{
	name=object_name(this_object());
	name_cn="【追赶】逐星护甲";
	unit="件";
	// 复用已随源码和Web镜像发布的胸甲美术，旧JSP也不会出现裂图。
	picture="49shiwangzhankai";
	desc="为回归与新进修士准备的过渡护甲。需绑定激活，仅在30～89级PVE中提供属性。\n";
	item_cur_dura=10000;
	item_dura=10000;
	set_item_type("armor");
	set_item_kind("armor_cloth");
	set_item_canEquip(1);
	set_item_canDrop(0);
	set_item_canGet(0);
	set_item_canTrade(0);
	set_item_canSend(0);
	set_item_canStorage(0);
	set_item_only(1);
	set_item_canLevel(30);
	foreach(({"jianxian","yushi","zhuxian","kuangyao","wuyao",
		"yinggui","fangshi","zhenyue","tianxiang","lingyi",
		"wuxiang","taiji"}),string profession)
		set_item_profeLimit(profession);
	set_equip_defend(520);
	set_all_add(18);
	set_life_add(100);
	set_item_from("catchup");
	set_catchup_equipment(100,89);
}

int query_equip_defend()
{
	return query_catchup_effect_enabled() ? ::query_equip_defend() : 0;
}
int query_all_add()
{
	return query_catchup_effect_enabled() ? ::query_all_add() : 0;
}
int query_life_add()
{
	return query_catchup_effect_enabled() ? ::query_life_add() : 0;
}
