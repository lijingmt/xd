#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_JEWELRY;

protected void create()
{
	name=object_name(this_object());
	name_cn="【追赶】逐星灵戒";
	unit="枚";
	// 复用已随源码和Web镜像发布的戒指美术，旧JSP也不会出现裂图。
	picture="50piaoyuezhihuan";
	desc="兼顾物理与法术成长的过渡灵戒。需绑定激活，仅在30～89级PVE中提供属性。\n";
	item_cur_dura=10000;
	item_dura=10000;
	set_item_type("jewelry");
	set_item_kind("jewelry_ring");
	set_item_canEquip(1);
	set_item_canDrop(0);
	set_item_canGet(0);
	set_item_canTrade(0);
	set_item_canSend(0);
	set_item_canStorage(0);
	set_item_only(1);
	set_item_canLevel(30);
	foreach(({"jianxian","yushi","zhuxian","kuangyao","wuyao",
		"yinggui","fangshi","zhenyue","tianxiang","lingyi",
		"wuxiang","taiji"}),string profession)
		set_item_profeLimit(profession);
	set_all_add(20);
	set_attack_all_add(32);
	set_mofa_all_add(32);
	set_hitte_add(4);
	set_item_from("catchup");
	set_catchup_equipment(100,89);
}

int query_all_add()
{
	return query_catchup_effect_enabled() ? ::query_all_add() : 0;
}
int query_attack_all_add()
{
	return query_catchup_effect_enabled() ? ::query_attack_all_add() : 0;
}
int query_mofa_all_add()
{
	return query_catchup_effect_enabled() ? ::query_mofa_all_add() : 0;
}
int query_hitte_add()
{
	return query_catchup_effect_enabled() ? ::query_hitte_add() : 0;
}
