	item_dura=10000;
	set_item_type("decorate");
	set_item_kind("decorate_thing");
	set_item_canEquip(1);
	set_item_canDrop(0);
	set_item_canGet(0);
	set_item_canTrade(0);
	set_item_canSend(0);
	set_item_canStorage(0);
	set_item_only(1);
	set_item_canLevel(30);
	foreach(({"jianxian","yushi","zhuxian","kuangyao","wuyao",
		"yinggui","fangshi","zhenyue","tianxiang","lingyi",
		"wuxiang","taiji"}),string profession)
