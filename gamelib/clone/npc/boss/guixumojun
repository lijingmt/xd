#include <gamelib/include/gamelib.h>
inherit GAMELIB_NPC;
// 团队硬 Boss 1：归墟魔君。位置：归墟境。
// 设计目标：纯物理硬 Boss，HP 28 万、攻击 2500-3500。
// 镇越用 dizhenhou 强制 first_target 拉住，dps 在背后输出，
// 灵医群疗维持 tank 生命，灵医注意仇恨（10:1 已存在）。
// 必杀技每 20 秒一次：归墟魔击 全房 AOE 5000。
protected void create(){
	name=object_name(this_object());
	_boss=1;
	_team_required_boss=1;
	_team_required_min_size=3;
	_flushtime=1800; // 30 分钟重生
	name_cn="归墟魔君";
	desc="一尊从归墟深渊升起的魔影，目光如炬，只允强者近身。\n";
	set_raceId("third");
	set_profeId("humanlike");
	picture="1";
	_npcLevel=120;
	set_base_str(5000);
	set_base_dex(5000);
	set_base_think(3000);
	set_base_life(300000000);
	this_object()->query_life_max();
	set_base_baoji(20);
	set_base_hitte(200);
	set_base_dodge(50);
	setup_npc();
	// 给 Boss 一个固定攻击技能，确保伤害稳定可控
	if(this_object()->skills)
		this_object()->skills=([]);
	this_object()->skills=(["guixumojiji":({3,0})]);
	this_object()->skills_enable="guixumojiji";
	set_heart_beat(1);
}
string query_words(){
	string s = ::query_words();
	s += "归墟魔君冷冷看着你，毫不掩饰杀意。\n";
	s += "【硬 Boss】需 3 人以上队伍挑战；伤害高，必须有坦克拉住仇恨。\n";
	s += TASKD->query_words(this_player(),this_object());
	return s;
}
string query_links(void|int count){
	return ::query_links(count);
}
