#include <gamelib/include/gamelib.h>
inherit GAMELIB_NPC;
// 团队硬 Boss 2：万象妖皇。位置：万象林。
// 设计目标：混合物法 Boss，HP 22 万、攻击 1800-2800。
// 必杀技每 25 秒一次：万象侵蚀 给全房挂 12 秒 DOT（每 3 秒 800）。
// 灵医需要净化 + 群疗双线操作。
protected void create(){
	name=object_name(this_object());
	_boss=1;
	_team_required_boss=1;
	_team_required_min_size=4;
	_flushtime=1800;
	name_cn="万象妖皇";
	desc="万象林深处的妖皇，掌握万象侵蚀之力，让贸然来犯者节节败退。\n";
	set_raceId("monst");
	set_profeId("humanlike");
	picture="1";
	_npcLevel=110;
	set_base_str(4000);
	set_base_dex(5000);
	set_base_think(4000);
	set_base_life(250000000);
	this_object()->query_life_max();
	set_base_baoji(25);
	set_base_hitte(220);
	set_base_dodge(45);
	setup_npc();
	if(this_object()->skills)
		this_object()->skills=([]);
	this_object()->skills=(["wanxiangqinshi":({3,0})]);
	this_object()->skills_enable="wanxiangqinshi";
	set_heart_beat(1);
}
string query_words(){
	string s = ::query_words();
	s += "万象妖皇周身环绕着万象之力。\n";
	s += "【硬 Boss】需 4 人以上队伍挑战；攻击力高，必杀技附带持续伤害，需灵医净化。\n";
	s += TASKD->query_words(this_player(),this_object());
	return s;
}
string query_links(void|int count){
	return ::query_links(count);
}
