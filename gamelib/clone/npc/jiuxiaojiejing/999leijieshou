#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit GAMELIB_NPC;
protected void create(){
	name=object_name(this_object());
	desc="吞吐天雷而生的巨兽，每一次踏步都震得云海翻涌。\n";
	set_raceId("third");
	set_profeId("beast");
	sex="male";
	gender="雄";
	pronoun="它";
	picture="beast_male";
	_npcLevel=999;
	name_cn="太古雷劫兽";
	setup_npc();
}
string query_words(){
	string s = ::query_words();
	s += TASKD->query_words(this_player(),this_object());
	return s;
}
string query_links(void|int count){
	return ::query_links(count);
}
void fight_die(){
	::fight_die();
}
