#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit GAMELIB_NPC;
protected void create(){
	name=object_name(this_object());
	_boss=1;
	_flushtime=36000;
	name_cn="【离三界】残忍年兽";
	desc="头长触角，凶残异常，虽然看得到，但摸不到，非常难对付。需要离三界境界才能降服。\n";
	set_raceId("third");
	set_profeId("fish");
	picture="nianshou";
	_npcLevel=100;
	set_base_think(3000);
	set_base_dex(2000);//降低闪避
	set_base_str(7000);
	set_base_life(1000000000);
	this_object()->query_life_max();
	set_base_baoji(100);
	set_base_hitte(200);
	set_base_dodge(100);//降低闪避
	setup_npc();
	set_heart_beat(1);
}
string query_words(){
	string s = ::query_words();
	s += TASKD->query_words(this_player(),this_object());
	return s;
}
string query_links(void|int count){
	return ::query_links(count);
}
void fight_die(){
	// 终极年兽强化掉落（玩家反馈：1京血量几十年才打死，原掉落
	// 只有三颗灵石不值得）。击杀者按Boss通用路径额外获得保底：
	// 淬炼石×3 + 离火玉×2；普通装备掉落走全队最高幸运+难度补偿。
	object killer = who_fight_npc ? find_player(who_fight_npc) : 0;
	if(killer){
		for(int i=0;i<3;i++)
			catch{
				object stone=clone(ROOT+
					"/gamelib/clone/item/material/cuilianshi");
				if(stone) stone->move(killer);
			};
		for(int i=0;i<2;i++)
			catch{
				object jade=clone(ROOT+
					"/gamelib/clone/item/material/lihuoyu");
				if(jade) jade->move(killer);
			};
		tell_object(killer,"【离三界】残忍年兽轰然倒下，"+
			"额外掉落淬炼石×3、离火玉×2！\n");
	}
	::fight_die();
}
