string query_links(){
	object player=this_player();
	if(!player) return "";  // 添加 NULL 检查
	string tmp="";
	if(player->have_name_cn() && (!player->user_pic || player->user_pic==""))
		tmp+="[选择头像:set_pic]\n";
	else if(!player->have_name_cn()){
		if(player->can_use_room_race(room_race) || player->query_raceId()=="third")  // third=方士可在人类区取名字
			tmp+="[取名字:set_name_cn]\n";
	}
	//if(player->set_pic_ok==0)
	//	tmp+="[更换图片:set_pic]\n";

	//由liaocheng于07/08/15添加，用于人推人系统
	if(player->set_presenter == "can_set")
		tmp += "[填写推荐人:present_set]\n";

	if(player->can_use_room_race(room_race)){
		tmp+="[休息:sleep]\n";
		object env=environment(player);
		string cur_pos=file_name(env)-ROOT;
		if(player->relife){
			if(player->relife!=cur_pos)
				tmp+="[设置复活点:set_relife "+cur_pos+"]\n";
		}else
			tmp+="[设置复活点:set_relife "+cur_pos+"]\n";
	}
	// 方士技能学习链接
	if(player->query_profeId()=="fangshi"){
		tmp+="[学习方士技能:buy_items book fangshi]\n";
	}
	if(player->query_profeId()=="zhenyue")
		tmp+="[学习镇越技能:buy_items book zhenyue]\n";
	if(player->query_profeId()=="tianxiang")
		tmp+="[学习天象技能:buy_items book tianxiang]\n";
	if(player->query_profeId()=="lingyi")
		tmp+="[学习灵医技能:buy_items book lingyi]\n";
	tmp+="[⚔ 团队硬 Boss·万象林（需 3 人队伍）:leave northeast]\n";
	return tmp;
}
void init()
{
	add_action(set_name_cn,"set_name_cn");
	add_action(set_gender,"set_gender");
	add_action(set_pic,"set_pic");
}
int set_name_cn(string|zero arg)                                                                                       
{
	string s;                                                                                                        
	object me = this_player();                                                                                       
	if(me->sid == "5dwap"){
		tell_object(me,"欢迎尝试仙道，您现在是游客身份，你的档案将不会被保存，欢迎点击注册一个正式帐号来体验仙道的乐趣。\n[注册帐号:reg_account]\n[返回游戏:look]\n");
		return 1; 
	}
	if(me->have_name_cn()){
		s = "你已经有名字了，每个人只能取一次名字。\n";                                                                 
		me->write_view(WAP_VIEWD["/emote"],0,0,s);                                                                          
		return 1;                                                                                                      
	}                                                                                                                
	if(arg){
		//werror("===== 69 arg "+arg+"\n"); 
		if(search(arg," ")!=-1) {//这里去重，有起名字老是重复2次，中间有空格
			array(string) t=arg/" ";
			if(sizeof(t)==2&&t[0]==t[1]){
				arg=t[0];
			}
		}                                                                                                        
		arg=replace(arg,(["%20":""]));                                                                                  
	}                                                                                                                
	else{                                                                                                            
		s = "请输入你的中文姓名，一旦选定无法更改，请仔细选取：[set_name_cn ...]\n";                                    
		me->write_view(WAP_VIEWD["/emote"],0,0,s);                                                                          
		return 1;                                                                                                       
	}                                                                                                                
	if(arg&&arg!=""){
		//////////////////////////////////////////////////////////////////////////////////
		//arg = Charset.encoder("GB18030")->feed(arg)->drain();
		arg = Charset.encoder("iso-8859-1")->feed(arg)->drain();
		//////////////////////////////////////////////////////////////////////////////////
		if(NAMESD->is_name_reserved(arg)){                                                                         
			s = "你不能取那种奇怪的名字。\n";                                                                              
			me->write_view(WAP_VIEWD["/emote"],0,0,s);    
			return 1;                                                                                                      
		}
		else if(NAMESD->is_name_regged(arg)){
			s = "你取得名字有人取过了,请另外取一个名字。\n";
			me->write_view(WAP_VIEWD["/emote"],0,0,s);
			return 1;   
		}
		else if(sizeof(arg)>8){ 
			werror("=====90arg "+arg+"\n");                                                                                        
			s = "名字长度不能超过四个中文汉字。\n";                                                                        
			me->write_view(WAP_VIEWD["/emote"],0,0,s);
			return 1;                                                                                                      
		}                                                                                                               
		else{                                                                                                           
			for(int i=0;i<sizeof(arg);i++){                                                                                
				if(arg[i]>=0&&arg[i]<=127){
					if(arg[i]>='a'&&arg[i]<='z'||arg[i]>='A'&&arg[i]<='Z'||arg[i]>='0'&&arg[i]<='9'){     
					}
					else{
						s = "请使用中文、英文字母或者数字取名。\n";
						me->write_view(WAP_VIEWD["/emote"],0,0,s);
						return 1;
					}
				}
			}                                                                                                              
			me["/tmp/tmp"]=arg; 
		} 
	} 
	me->command("set_gender"); 
	return 1; 
}
int set_gender(string|zero arg)                                                                                        
{                                                                                                                 
	string s;                                                                                                        
	object me = this_player();                                                                                       
	if(me->sex=="male" || me->sex=="female"){
		me->name_cn=me["/tmp/tmp"]; 
		NAMESD->reg_name(me->name_cn);
		me->command("set_pic");
		return 1;
	}
	if(!arg){                                                                                                        
		s = "请选择你的性别，一旦选定无法更改，请仔细选取：[男:set_gender male] [女:set_gender female]\n";              
		me->write_view(WAP_VIEWD["/emote"],0,0,s); 
		return 1; 
	} 
	if(arg=="male"||arg=="female"){ 
		if(arg=="female") 
			COUNTD->count_reg_female();//统计系统 
		me->sex=arg;
		me->name_cn=me["/tmp/tmp"]; 
		//新起的名字要加到列表里
		NAMESD->reg_name(me->name_cn);
		me->command("set_pic");
	} 
	else{ 
		s = "性别输入错误。\n"; 
		me->write_view(WAP_VIEWD["/emote"],0,0,s); 
	}
	return 1; 
}

array(string) query_pic_choices(object me)
{
	array(string) choices = ({});
	string raceId;
	string sex;
	string prefix = "";
	int max_pic = 0;
	if(!me)
		return choices;
	raceId = me->query_raceId();
	sex = me->sex || "male";
	if(sex!="male" && sex!="female")
		sex = "male";
	if(raceId=="human" || raceId=="third"){
		if(raceId=="third" && me->query_profeId()=="zhenyue")
			choices += ({"zhenyue_"+sex});
		if(raceId=="third" && me->query_profeId()=="tianxiang")
			choices += ({"tianxiang_"+sex});
		if(raceId=="third" && me->query_profeId()=="lingyi")
			choices += ({"lingyi_"+sex});
		if(raceId=="third" && me->query_profeId()=="wuxiang")
			choices += ({"wuxiang_"+sex});
		if(raceId=="third" && me->query_profeId()=="taiji")
			choices += ({"taiji_"+sex});
		if(sex=="male"){
			prefix = "h_male";
			max_pic = 11;
		}
		else{
			prefix = "h_female";
			max_pic = 12;
		}
	}
	else if(raceId=="monst"){
		if(sex=="male"){
			prefix = "m_male";
			max_pic = 12;
		}
		else{
			prefix = "m_female";
			max_pic = 11;
		}
	}
	for(int i=1;i<=max_pic;i++)
		choices += ({prefix+i});
	return choices;
}

int set_pic(string|zero arg)
{
	string s = "";
	object me = this_player();
	array(string) choices;
	if(!me) {
		return 0;
	}
	if(me->user_pic && me->user_pic != ""){
		if(me->set_pic_ok==0){
			me->set_pic_ok = 1;
			me->command("save");
		}
		s += "你已经选择了头像，无法再次更换。\n";
		me->write_view(WAP_VIEWD["/emote"],0,0,s);
		return 1;
	}
	choices = query_pic_choices(me);
	if(!sizeof(choices)){
		s += "你的角色资料不完整，暂时无法选择头像。\n";
		me->write_view(WAP_VIEWD["/emote"],0,0,s);
		return 1;
	}
	if(!arg){
		s += "请选择你的头像：\n";
		for(int i=0;i<sizeof(choices);i++){
			s += "[imgurl loading:/"+GAME_NAME+"/images/"+choices[i]+".gif]";
			s += "[选择:set_pic "+choices[i]+"]\n";
		}
		me->write_view(WAP_VIEWD["/emote"],0,0,s);
	}
	else{
		if(!has_value(choices,arg)){
			s += "头像选择无效，请从头像列表中重新选择。\n";
			me->write_view(WAP_VIEWD["/emote"],0,0,s);
		}
		else{
			me->user_pic=arg;
			me->set_pic_ok = 1;
			me->command("save");
			me->command("look");
		}
	}
	return 1;
}
