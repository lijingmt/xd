string check_mobile(string str)
{
	string desc="";
	if(sizeof(str) == 0 || ""==str){
		desc += "手机号码不能为空\n";
	}
	else
	{
		//check_mobile str=[18612991153 18612991153]
		if(search(str," ")!=-1) {//这里去重，有起名字老是重复2次，中间有空格
			array(string) t=str/" ";
			if(sizeof(t)==2&&t[0]==t[1]){
				str=t[0];
			}
		}
		str=replace(str,(["%20":""]));      
		//check_mobile 222 str=[18612991153]
		//check_mobile 333 sizeof(str)=[11]
		if(sizeof(str)!=11)
		{
			desc += "你输入的手机号码位数不正确\n";
		}
	}
	return desc;
}

int check_password(string arg){
	object me=this_player();
	if(!arg){
		if(me->password==0)
			me->command("set_password");
		else
		{
			write("请输入您的原帐号密码\n");
			write("[string:check_password ...]\n");
			write("[返回:look]\n");
		}
	}
	else{
		string password=arg;
		array(string) t_arg=arg/" ";//如果arg有重复的例如：123456 123456
		if(sizeof(t_arg)==2 && t_arg[0]==t_arg[1])
			password=t_arg[0];
		if(sizeof(password)<2||sizeof(password)>=12)
		{
			//格式不对
			write("密码验证错误。\n");
			write("请输入您的原帐号密码\n");
			write("[string:check_password ...]\n");
			write("[返回:look]\n");
		}
		else if(password[0]>127||password[0]<0)
		{
			write("密码验证错误。\n");
			write("请输入您的原帐号密码\n");
			write("[string:check_password ...]\n");
			write("[返回:look]\n");
		}
		else
		{
			int flag = 1;
			for(int i=0;i<sizeof(password);i++)
			{
				if( password[i]>='a'&&password[i]<='z'||password[i]>='A'&&password[i]<='Z'||password[i]>='0'&&password[i]<='9')
				{
					;	
				}
				else
				{
					flag = 0;
				}
			}
			if(flag)
			{
				if(me->password==password)
					me->command("set_password");
				else
				{
					write("密码验证错误。\n");
					write("请输入您的原帐号密码\n");
					write("[string:check_password ...]\n");
					write("[返回:look]\n");
				}
			}
			else
			{
				write("密码验证错误。\n");
				write("请输入您的原帐号密码\n");
				write("[string:check_password ...]\n");
				write("[返回:look]\n");
			}
		}
	}
	return 1;
}

int set_password(string arg){
	object me=this_player();
	if(!arg)
	{
		write("验证成功，请输入您的新密码（必须是英文或者数字）\n");
		write("[string:set_password ...]\n");
		write("[返回:look]\n");
	}
	else
	{
		string password=arg;
		array(string) t_arg=arg/" ";//如果arg有重复的例如：123456 123456
		if(sizeof(t_arg)==2 && t_arg[0]==t_arg[1])
			password=t_arg[0];
		if(sizeof(password)<2||sizeof(password)>=12)
		{
			//格式不对
			write("您输入的新密码太长或者太短，请重新输入\n");
			write("[string:set_password ...]\n");
			write("[返回:look]\n");
		}
		else if(password[0]>127||password[0]<0)
		{
			//格式不对
			write("您输入的新密码有特殊字符，请重新输入\n");
			write("[string:set_password ...]\n");
			write("[返回:look]\n");
		}
		else
		{
			int flag = 1;
			for(int i=0;i<sizeof(password);i++)
			{
				if( password[i]>='a'&&password[i]<='z'||password[i]>='A'&&password[i]<='Z'||password[i]>='0'&&password[i]<='9')
				{
					;	
				}
				else
				{
					flag = 0;
				}
			}
			if(flag)
			{
				mapping changed = ACCOUNT_CHARACTERD->
					change_account_password(me,password);
				if(changed["ok"]){
					string now=ctime(time());
					Stdio.append_file(LOG_PATH,"["+now[0..sizeof(now)-2]+"]["+me->name+"]["+me->name_cn+"][设置密码成功][账号同步人物数"+changed["updated"]+"]\n");
					write((string)changed["message"]+"\n");
					me->command("save");
				}
				else
					write((string)changed["message"]+"\n");
				write("[返回:look]\n");
			}
			else
			{
				write("您输入的新密码含有特殊字符，请重新输入.\n");
				write("[string:set_password ...]\n");
				write("[返回:look]\n");
			}
		}
	}
	return 1;
}

