			me->last_pos = "/gamelib/d/"+saved_fb_leave;
		}
		//副本和家园的特殊处理
		array allPos = me->last_pos/"#";
		int num = sizeof(allPos);
		if(num == 2) //表示玩家在副本或者家园中
		{
			if(me->inhome_pos=="")            //玩家在副本中
			{
				me->last_pos = (me->last_pos/"#")[0];
				string fb_name = "";
				fb_name = (me->fb_id/"/")[1];
				me->last_pos="/gamelib/d/"+FBD->query_fb_leave_room(fb_name);

				object last = (object)(ROOT+me->last_pos);
				if(!last || last->query_room_type() == "fb"){
					fb_name = (me->fb_id/"/")[1];
					me->last_pos="/gamelib/d/"+FBD->query_fb_leave_room(fb_name);
				}
				if(me->last_pos){
					mixed err=catch{
						(object)(ROOT+me->last_pos);
					};
					if(!err)
						me->move(ROOT+me->last_pos);
				}
			}
			else                              //玩家在家园中
			{
				object room;
				if(LOGICALZONED->can_user_action("home",
				   me->query_name(),me->inhome_pos))
					room = HOMED->query_home_by_masterId(me->inhome_pos);
				if(room){
					me->move(room);
					HOMED->add_user(me->query_name());
				}
				//该玩家在某个home中，但是在这期间，主人将home变卖了，就会进入到这里。
				else{		
					me->last_pos = "/gamelib/d/ninggedian/ninggedian";
					me->inhome_pos = "";//将inhome_pos置空，以免下次登陆再次进入到这里。
					if(me->last_pos){
						mixed err=catch{
							(object)(ROOT+me->last_pos);
						};
						if(!err)
							me->move(ROOT+me->last_pos);
					}

				}
			}
		}
		//副本和家园的特殊处理 结束	
		else
		{
			if(me->last_pos){
				mixed err=catch{
					(object)(ROOT+me->last_pos);
				};
				if(!err)
					me->move(ROOT+me->last_pos);
			}
		}

	}
	else
	{
		if(!me->last_pos){
			if(arg=="human")
				me->last_pos="/gamelib/d/congxianzhen/xiaomuwu";
			if(arg=="monst")
				me->last_pos="/gamelib/d/jinaodao/maocaowu";
			// 方士根据进入阵营决定出生点
			if(me->query_raceId()=="third"){
				if(arg=="human")
					me->last_pos="/gamelib/d/congxianzhen/xiaomuwu";
				else if(arg=="monst")
					me->last_pos="/gamelib/d/jinaodao/maocaowu";
				else{
					// 随机出生点
					if(random(2)==0)
						me->last_pos="/gamelib/d/congxianzhen/xiaomuwu";
					else
						me->last_pos="/gamelib/d/jinaodao/maocaowu";
				}
			}
		}
		/*
		//在副本中则要把玩家传到副本外
		me->last_pos = (me->last_pos/"#")[0];
		object last = (object)(ROOT+me->last_pos);
		if(!last || last->query_room_type() == "fb"){
		string fb_name = (me->fb_id/"/")[1];
		me->last_pos="/gamelib/d/"+FBD->query_fb_leave_room(fb_name);
		}

		me->last_pos=me->last_pos-ROOT;
		 */
		if(me->last_pos){
			mixed err=catch{
				(object)(ROOT+me->last_pos);
			};
			if(!err)
				me->move(ROOT+me->last_pos);
		}
	}
	me->command("look");
	return 1;
}

//add by calvin : 纪录日独立用户
int reguser(string arg)
{
	string webdir = ROOT+"/gamelib/data/uniq_user/"+GAME_NAME_S+".";
	if(!arg)
	{
		return 1;
	}
	else
	{
		string s_mon,s_day;                                                                           
		int year,mon,day=0;                                                                                    
		mapping now_time = localtime(time());                                                                     
		mon = now_time["mon"]+1;                                                                                  
		day = now_time["mday"];                                                                                   
		year = now_time["year"]+1900;
		if(mon<10)                                                                                                
			s_mon = "0"+mon;                                                                                  
		else                                                                                                      
			s_mon = (string)mon;                                                                              
		if(day<10)                                                                                                
			s_day = "0"+day;                                                                                  
		else                                                                                                      
			s_day = (string)day;

		string logdate = "";
		logdate += year+s_mon+s_day;

		Stdio.append_file(webdir+logdate+".txt",arg+"\n");
	}
	return 1;
}
