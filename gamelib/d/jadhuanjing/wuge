#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="third";
protected int room_level=10000;
array(string) flush_monst = ({"jadhuanjing/mojunshizu","jadhuanjing/mojunshizu","jadhuanjing/mojunshizu","jadhuanjing/mojunshizu",});
array(string) flush_human = ({"jadhuanjing/jingweiduishibing","jadhuanjing/jingweiduishibing","jadhuanjing/jingweiduishibing","jadhuanjing/jingweiduishibing",});
protected void create(){
	name=object_name(this_object());
	set_room_type("city");
	name_cn="武阁";
	desc="\n";
	set_belong_to("jadhuanjing");
	exits["east"]=ROOT "/gamelib/d/jadhuanjing/lianqifang";
	exits["west"]=ROOT "/gamelib/d/jadhuanjing/paimaihang";
	string tmp_s = CITYD->query_captured("jadhuanjing");
	if(tmp_s == "monst"){
		room_race="monst";
		name_cn += "(妖魔占领)";
		foreach(flush_monst,string item){
			if(item && sizeof(item))
				add_items(({ROOT "/gamelib/clone/npc/"+item}));
		}
	}
	else if(tmp_s == "human"){
		room_race="human";
		name_cn += "(人类占领)";
		foreach(flush_human,string item){
			if(item && sizeof(item))
				add_items(({ROOT "/gamelib/clone/npc/"+item}));
		}
	}
}
string query_links(){
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)){
		tmp+="当前角色仓库：[背包存入:user_package]|"+
			"[取到背包:user_repackage]|"+
			"[扩充容量:user_package_buy_list]\n";
		tmp+="跨职业转移：[账号共享仓库:account_storage]\n";
	}
	return tmp;
}
