#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="human";
protected int room_level=278;
protected void create(){
	name=object_name(this_object());
	name_cn="仙阵【将军墓】";
	desc="\n";
	exits["north"]=ROOT "/gamelib/d/jiangjunmu/huangjiazufen";
}
string query_links()                                                                                                         
{   
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)&&player->query_level()>=15)
		tmp+="[仙阵【玉虚宫】:qge74hye kunlunshan/xianzhenxuyugong]\n";
	return tmp;
}
