#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="third";
protected void create(){
	name=object_name(this_object());
	name_cn="归墟境";
	desc="一片深紫色的虚境，地面浮动着古老的符纹。\n"+
		"此处为团队硬 Boss「归墟魔君」的栖息之地，需 4 人以上队伍挑战。\n";
	exits["east"]=ROOT "/gamelib/d/jinaodao/yuhuacunguangchang";
	add_items(({ROOT "/gamelib/clone/npc/boss/guixumojun"}));
}
int is_peaceful(){
	return 0;
}
void reset_items(){
	int boss_count=0;
	array(object) extras=({});
	foreach(all_inventory(this_object()),object ob){
		if(ob && ob->is && ob->is("npc") &&
		   functionp(ob->is_team_required_boss) &&
		   ob->is_team_required_boss()){
			boss_count++;
			if(boss_count>1)
				extras+=({ob});
		}
	}
	foreach(extras,object extra){
		catch { extra->remove(); };
	}
	::reset_items();
}
