#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="human";
protected int room_level=92;
protected void create(){
	name=object_name(this_object());
	name_cn="武阁";
	desc="\n";
	exits["west"]=ROOT "/gamelib/d/kunlunshan/xianqifang";
	exits["east"]=ROOT "/gamelib/d/paimh/paimaihang_human";
}
string query_links(){
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)){
		tmp+="当前角色仓库：[背包存入:user_package]|"+
			"[取到背包:user_repackage]|"+
			"[扩充容量:user_package_buy_list]\n";
		tmp+="跨职业转移：[账号共享仓库:account_storage]\n";
	}
	return tmp;
}
