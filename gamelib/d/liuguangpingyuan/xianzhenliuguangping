#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="human";
protected int room_level=1131;
protected void create(){
	name=object_name(this_object());
	name_cn="仙阵【流光平原】";
	desc="\n";
	exits["east"]=ROOT "/gamelib/d/liuguangpingyuan/liuguangyizhan";
}
int is_peaceful()
{
	return 1;
}
string query_links() 
{   
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)&&player->query_level()>=40)
		tmp+="[仙阵【牧野】:qge74hye muye/xianzhenmuye]\n";
	return tmp;
}
