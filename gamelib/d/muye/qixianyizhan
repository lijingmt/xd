#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="monst";
protected int room_level=494;
protected void create(){
	name=object_name(this_object());
	name_cn="淇县驿站";
	desc="\n";
	exits["east"]=ROOT "/gamelib/d/muye/yaozhenmuye";
	exits["south"]=ROOT "/gamelib/d/muye/tieshuironglu";
	exits["west"]=ROOT "/gamelib/d/muye/qixiandaying";
	exits["north"]=ROOT "/gamelib/d/muye/yihuoxiaowu";
	add_items(({ROOT "/gamelib/clone/npc/muye/dongtianjun400"}));
}
int is_bedroom()
{
	return 1;
}
string query_links(){
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)){
		tmp+="[休息:sleep]\n";
		object env=environment(player);
		string cur_pos=file_name(env)-ROOT;
		if(player->relife){
			if(player->relife!=cur_pos)
				tmp+="[设置复活点:set_relife "+cur_pos+"]\n";
		}else
			tmp+="[设置复活点:set_relife "+cur_pos+"]\n";
	}
	return tmp;
}
