string query_links(){
	object player=this_player();
	string tmp="";
	if(player && player->query_level()>=ENDGAME_MAP_MIN_LEVEL)
		tmp+="[踏入九霄界境:qge74hye jiuxiaojiejing/jiuxiaotianmen]\n";
