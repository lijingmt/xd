#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="human";
protected int room_level=1206;
protected void create(){
	name=object_name(this_object());
	name_cn="仙阵【蓬莱仙境】";
	desc="\n";
	exits["south"]=ROOT "/gamelib/d/plxianjing/lingxianzhen";
	exits["north"]=ROOT "/gamelib/d/plxianjing/bingyueyunwu";
}
int is_peaceful()
{
	return 1;
}
string query_links() 
{   
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)&&player->query_level()>=50)
		tmp+="[仙阵【牧野】:qge74hye muye/xianzhenmuye]\n";
	if(player->can_use_room_race(room_race)&&player->query_level()>=58)
		tmp+="[仙阵【蓬莱幻境】:qge74hye penglaihuanjing/xianzhenplhj]\n";
	return tmp;
}
