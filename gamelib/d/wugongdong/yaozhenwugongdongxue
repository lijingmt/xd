#include <globals.h>
#include <gamelib/include/gamelib.h>
inherit WAP_ROOM;
string room_race="monst";
protected int room_level=113;
protected void create(){
	name=object_name(this_object());
	name_cn="妖阵【蜈蚣洞穴】";
	desc="\n";
	exits["south"]=ROOT "/gamelib/d/wugongdong/baizuguodao";
	exits["north"]=ROOT "/gamelib/d/wugongdong/chongshidijiao";
}
string query_links()                                                                                                         
{   
	object player=this_player();
	string tmp="";
	if(player->can_use_room_race(room_race)&&player->query_level()>=10)
		tmp+="[妖阵【碧游宫】:qge74hye jinaodao/yaozhenbiyougong]\n";
	return tmp;
}
