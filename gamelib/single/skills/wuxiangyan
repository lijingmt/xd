inherit WAP_SKILL;
protected void create(){
	name=object_name(this_object()); name_cn="【无】无相焰"; picture="wuxiangyan_logo";
	desc="无相横向通用群攻，3秒轮转、发挥法术专精60%的威力；随人物可用技能阶段覆盖2至10个目标";
	s_type="zhudong"; s_skill_type="balanced_aoe"; s_delayTime=3; lingyi_aoe_power_percent=60;
	performs_mofa_attack[1]=({35,55}); performs_mofa_attack[2]=({85,120}); performs_mofa_attack[3]=({170,220}); performs_mofa_attack[4]=({280,360}); performs_mofa_attack[5]=({420,540});
	performs_cast[1]=12; performs_cast[2]=20; performs_cast[3]=32; performs_cast[4]=46; performs_cast[5]=62;
	skill_type+=({"wuxiang"});
	performs_level_limit[1]=1; performs_level_limit[2]=21; performs_level_limit[3]=41; performs_level_limit[4]=61; performs_level_limit[5]=81;
	performs_desc[1]="最多攻击2个目标，造成35至55点法术伤害，消耗法力12点"; performs_desc[2]="最多攻击4个目标，造成85至120点法术伤害，消耗法力20点"; performs_desc[3]="最多攻击6个目标，造成170至220点法术伤害，消耗法力32点"; performs_desc[4]="最多攻击8个目标，造成280至360点法术伤害，消耗法力46点"; performs_desc[5]="最多攻击10个目标，造成420至540点法术伤害，消耗法力62点";
}

// 无相焰的横向覆盖随人物当前真正可用的技能阶段成长。战斗入口会先按
// 人物等级把已学技能降到可用阶段，再调用本接口，客户端无法抬高目标数。
int query_balanced_aoe_target_limit(int level){
	if(level<1)
		level=1;
	if(level>5)
		level=5;
	return level*2;
}
