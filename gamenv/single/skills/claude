// ============================================================================
// 五、Pike 9 语法注意
// ============================================================================

/*
【类型声明】

// 联合类型 (zero|object) 可能不支持，使用 mixed 代替
mixed room;           // 可以为 0 或 object
object room = 0;      // 可能报错，初始化为 0 需要注意

【create() 方法】

protected void create()  // Pike 9: create() 应该是 protected

【字符串操作】

// 字符串长度 (UTF-8)
int utf8_strlen(string str)

// 字符串索引
str[i]           // 获取单个字符
str[0..j-1]      // 子串
str[..sizeof(str)-2]  // 去掉最后一个字符

【映射操作】

mapping m = ([]);
m[key] = value;       // 设置
m[key]              // 获取
m_delete(m, key);    // 删除
indices(m);          // 获取所有键
values(m);           // 获取所有值

【数组操作】

array a = ({});
a += ({element});     // 添加元素
sizeof(a);           // 数组大小
*/

