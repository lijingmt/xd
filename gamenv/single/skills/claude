// ============================================================================
// 一、项目结构
// ============================================================================
//
// ROOT = /usr/local/games/oldtx/tx
//
// 核心目录:
// ├── pikenv/           # Pike 环境/核心系统
// │   ├── efuns.pike        # 全局函数 (users(), load_object()等)
// │   ├── connd.pike        # 连接管理器 (用户连接、虚拟连接)
// │   ├── mudlib/           # MUD 基础库
// │   └── wapmud2/         # WAPMUD2 系统
// │       ├── cmds/         # 命令文件
// │       └── inherit/     # 继承类
// ├── gamenv/           # 游戏环境
// │   ├── clone/          # 可克隆对象 (NPC、物品)
// │   │   └── npc/        # NPC 类
// │   │       └── bot_user.pike  # 假用户
// │   ├── d/              # 地图房间
// │   ├── single/         # 单例对象
// │   │   └── daemons/    # 守护进程
// │   │       └── botd.pike     # 假用户管理
