{
  "expo": {
    "name": "Xiandao 仙道",
    "slug": "xiand-client",
    "version": "0.2.4",
    "orientation": "any",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0b0e",
    "primaryColor": "#d4af37",
    "description": "Xiandao 仙道 - Oriental fantasy multi-class MUD RPG. xiandao xianxia cultivation text adventure with AFK farming.",
    "ios": {
      "bundleIdentifier": "com.wapmud.xiandao",
      "supportsTablet": true,
      "buildNumber": "15",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.wapmud.xiandao",
      "versionCode": 5,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/universal_icon.png",
        "backgroundColor": "#0d0b0e"
      }
    },
    "web": {
      "output": "single",
      "favicon": "assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minifyEnabled": true,
            "shrinkResources": true
          }
        }
      ]
    ],
    "scheme": "xiand"
  }
}