{
  "expo": {
    "name": "仙道wapmud",
    "slug": "xiand-client",
    "version": "0.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0b0e",
    "primaryColor": "#d4af37",
    "description": "仙道wapmud - 东方幻想多职业MUD，原生客户端",
    "ios": {
      "bundleIdentifier": "com.wapmud.xiandao",
      "supportsTablet": true,
      "buildNumber": "13",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "com.wapmud.xiandao",
      "versionCode": 3,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/universal_icon.png",
        "backgroundColor": "#0d0b0e"
      }
    },
    "web": {
      "output": "single",
      "favicon": "assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "xiand"
  }
}